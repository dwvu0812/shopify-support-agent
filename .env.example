# LLM provider — only ONE key is needed. If both are set, OpenAI wins.
# OpenAI (needs a paid key):
# OPENAI_API_KEY=<redacted>
# OPENAI_MODEL=gpt-4o-mini
# Gemini (free tier, get a key at aistudio.google.com -> Get API key):
GEMINI_API_KEY=<redacted>
# Default model is gemini-3.5-flash-lite (verified 2026-11-24).
# Do NOT use gemini-2.5-flash-lite: Google removed it for new users (404).
# gemini-3.8-flash was temporarily overloaded (503) when tested.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval
# CHROMA_PATH=./chroma_db
# RETRIEVAL_TOP_K=3

# Shop data (seed files shipped in the repo; point at a Shopify export
# or a live sync in production)
# DATA_DIR=./data
# DOCS_DIR=./docs

# Admin endpoint: if set, POST /admin/docs requires this token
# in the X-Admin-Token header. Leave unset only for local demos.
# ADMIN_TOKEN=change-me-in-production

# API behaviour
# MAX_QUESTION_LENGTH=2000
# RATE_LIMIT_PER_MINUTE=60
# LLM_TIMEOUT_SECONDS=60
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
